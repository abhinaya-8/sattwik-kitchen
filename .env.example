# Server
PORT=5000
NODE_ENV=production

# MongoDB connection string (use MongoDB Atlas for production)
# Get your connection string from: https://cloud.mongodb.com/
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/sattwik_kitchen

# Secret for signing JWT tokens (use a long random string in production)
# Generate one at: https://www.random.org/strings/
JWT_SECRET=your_long_random_secret_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# Allowed origins for CORS (comma separated)
# For production, add your Render URL: https://your-app.onrender.com
CORS_ORIGIN=https://your-app.onrender.com

# WhatsApp number used in public-site order messages
WHATSAPP_NUMBER=16725881282


# Primary admin bootstrap (created on server start if it does not exist)
# Set these in the Render dashboard — never commit real values
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=Owner
ADMIN_PASSWORD=
