# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/sattwik-kitchen

# Secret for signing JWT tokens (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Allowed origins for CORS (comma separated). Leave blank to allow all in dev.
CORS_ORIGIN=

# WhatsApp number used in public-site order messages
WHATSAPP_NUMBER=16725881282

